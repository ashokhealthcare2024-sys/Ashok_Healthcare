# ==============================================================================
# ASHOK HOME HEALTHCARE SERVICES - APACHE / CPANEL PRODUCTION CONFIGURATION
# ==============================================================================

# 1. CHARACTER ENCODING
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .json .svg .xml

# 2. DEFAULT DOCUMENT & CUSTOM ERROR PAGES
DirectoryIndex index.html
ErrorDocument 404 /404.html

# 3. PREVENT DIRECTORY BROWSING & DISABLE MULTIVIEWS
# Disable MultiViews so Apache strictly requires file extensions and never serves .html for extensionless URLs
Options -Indexes -MultiViews

# Disable spelling auto-correction so approximate URLs never resolve
<IfModule mod_speling.c>
  CheckSpelling Off
</IfModule>

# 4. JAPANESE SPAM HACK BLOCK (410 GONE SIGNAL)
# Japanese Spam Hack Pages ko Fast Delete Karne Ke Liye (410 Gone Signal)
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Ensure valid site pages and assets are NEVER blocked
  RewriteCond %{REQUEST_URI} !^/medical-equipment [NC]
  RewriteCond %{REQUEST_URI} !^/(assets|components|images|services|blog) [NC]
  # Target only actual spam hack URL structures
  RewriteCond %{REQUEST_URI} ^/(ja|jp)(/|$) [NC,OR]
  RewriteCond %{REQUEST_URI} ^/(m|x|j|o|q|z)(/|[0-9]|\.php|\.html?|$) [NC,OR]
  RewriteCond %{REQUEST_URI} ^/[0-9]+(\.html?|\.php|/|$) [NC]
  RewriteRule ^ - [R=410,L]
</IfModule>

# 5. HTTPS ENFORCEMENT & CANONICAL DOMAIN (NON-WWW)
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 5A. Redirect www to non-www (https://ashokhealthcare.in)
  RewriteCond %{HTTP_HOST} ^www\.ashokhealthcare\.in$ [NC]
  RewriteRule ^(.*)$ https://ashokhealthcare.in/$1 [L,R=301]

  # 5B. Redirect HTTP to HTTPS
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://ashokhealthcare.in/$1 [L,R=301]
</IfModule>

# 6. SEO 301 CANONICAL REDIRECTS FOR DUPLICATE & DIRECTORY URLS
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Legacy About page
  RewriteRule ^about-ashok-healthcare-bangalore\.html$ /about.html [R=301,L]

  # Legacy Services root & legacy service pages
  RewriteRule ^services/?$ /services.html [R=301,L]
  RewriteRule ^services/index\.html$ /services.html [R=301,L]
  RewriteRule ^services/home-healthcare-services-bangalore\.html$ /services.html [R=301,L]
  RewriteRule ^services/home-healthcare-nursing-services-bangalore\.html$ /services.html [R=301,L]
  RewriteRule ^services/ambulance\.html$ /ambulance-services.html [R=301,L]
  RewriteRule ^services/diagnostic-services\.html$ /diagnostics.html [R=301,L]
  RewriteRule ^services/physiotherapy\.html$ /physiotherapy.html [R=301,L]
  RewriteRule ^services/rehabilitation\.html$ /rehabilitation-neuro-and-ortho.html [R=301,L]

  # Duplicate subfolders: redirect folder, trailing slash, and index.html to root canonical .html
  RewriteRule ^ambulance-services(/.*)?$ /ambulance-services.html [R=301,L]
  RewriteRule ^diagnostics(/.*)?$ /diagnostics.html [R=301,L]
  RewriteRule ^physiotherapy(/.*)?$ /physiotherapy.html [R=301,L]
  RewriteRule ^rehabilitation-neuro-and-ortho(/.*)?$ /rehabilitation-neuro-and-ortho.html [R=301,L]
  RewriteRule ^medical-equipment-rent-and-sales(/.*)?$ /medical-equipment-rent-and-sales.html [R=301,L]
</IfModule>

# 7. BLOCK ACCESS TO INTERNAL & SENSITIVE FILES AND DIRECTORIES
<IfModule mod_rewrite.c>
  RewriteRule ^(node_modules|src|test|\.git)(/|$) - [R=404,L,NC]
</IfModule>

<FilesMatch "^(\.git|\.env.*|\.cpanel\.yml|\.gitignore|package.*\.json|vite\.config\.js|server\.js|README\.md|vercel\.json)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# 6. VIDEO STREAMING & HTTP RANGE REQUESTS
# Essential for clinical MP4/WebM video playback & seeking across Safari & Chrome
<IfModule mod_headers.c>
  <FilesMatch "\.(mp4|webm|mov|ogg)$">
    Header set Accept-Ranges bytes
  </FilesMatch>
</IfModule>

# 7. MIME TYPES FOR MODERN WEB FORMATS
<IfModule mod_mime.c>
  AddType image/svg+xml .svg .svgz
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType video/webm .webm
  AddType font/woff .woff
  AddType font/woff2 .woff2
  AddType application/json .json
  AddType application/xml .xml
</IfModule>

# 8. GZIP / DEFLATE COMPRESSION
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf font/otf application/vnd.ms-fontobject
</IfModule>

# 9. BROWSER CACHING (mod_expires / mod_headers)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML documents - Revalidate for instant updates
  ExpiresByType text/html "access plus 0 seconds"

  # Stylesheets & Scripts
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Media & Images
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Videos
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType video/webm "access plus 1 month"

  # Fonts
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
</IfModule>

# 10. SECURITY HEADERS
<IfModule mod_headers.c>
  # Protect against MIME type sniffing
  Header set X-Content-Type-Options "nosniff"
  # Clickjacking defense
  Header set X-Frame-Options "SAMEORIGIN"
  # Referrer policy for privacy
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
