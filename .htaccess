# ==============================================================================
# ASHOK HEALTHCARE - APACHE / CPANEL PRODUCTION CONFIGURATION
# Canonical HTTPS + Non-WWW + HTML-Only Page URLs + SEO-Safe 404
# ==============================================================================

# 1. CHARACTER ENCODING
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .json .svg .xml

# 2. DEFAULT DOCUMENT & CUSTOM ERROR PAGE
DirectoryIndex index.html
ErrorDocument 404 /404.html

# 3. PREVENT DIRECTORY BROWSING & MULTIVIEWS
Options -Indexes -MultiViews

# Disable spelling auto-correction
<IfModule mod_speling.c>
    CheckSpelling Off
</IfModule>

# 4. HTTPS, NON-WWW & CANONICAL HOMEPAGE
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 4A. Redirect WWW and HTTP to HTTPS non-WWW
    RewriteCond %{HTTP_HOST} ^www\.ashokhealthcare\.in$ [NC,OR]
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://ashokhealthcare.in%{REQUEST_URI} [R=301,L,NE]

    # 4B. Canonical homepage URL
    RewriteRule ^$ https://ashokhealthcare.in/index.html [R=301,L]

    # 5. LEGACY MEDIA URL REDIRECTS
    # Redirect old image locations only when the target structure is confirmed.

    RewriteRule ^images/(.+)$ /assets/images/$1 [R=301,L,NC]
    RewriteRule ^Gallery/(.+)$ /assets/gallery/$1 [R=301,L,NC]

    # 6. ENFORCE HTML-ONLY PAGE URLS
    # Existing page URLs must include .html.
    # Extensionless URLs must not be internally mapped to HTML files.

    RewriteCond %{REQUEST_URI} !^/$
    RewriteCond %{REQUEST_URI} !\.[^/]+$
    RewriteRule ^ - [R=404,L]

</IfModule>

# 7. COMPRESSION
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
    AddOutputFilterByType BROTLI_COMPRESS text/javascript application/javascript
    AddOutputFilterByType BROTLI_COMPRESS application/json application/xml
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE text/javascript application/javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 8. BLOCK ACCESS TO SENSITIVE FILES
<IfModule mod_authz_core.c>
    <FilesMatch "^(\.env.*|\.git.*|\.cpanel\.yml|\.gitignore|README\.md)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "^(\.env.*|\.git.*|\.cpanel\.yml|\.gitignore|README\.md)$">
        Order deny,allow
        Deny from all
    </FilesMatch>
</IfModule>

# 9. MIME TYPES
<IfModule mod_mime.c>
    AddType image/svg+xml .svg .svgz
    AddType image/webp .webp
    AddType video/mp4 .mp4
    AddType video/webm .webm
    AddType font/woff .woff
    AddType font/woff2 .woff2
    AddType application/json .json
    AddType application/xml .xml
</IfModule>

# 10. BROWSER CACHING
<IfModule mod_expires.c>
    ExpiresActive On

    ExpiresDefault "access plus 1 month"

    # HTML documents
    ExpiresByType text/html "access plus 0 seconds"

    # CSS and JavaScript
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Images
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Videos
    ExpiresByType video/mp4 "access plus 1 month"
    ExpiresByType video/webm "access plus 1 month"

    # Fonts
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 11. HTTP HEADERS
<IfModule mod_headers.c>

    # Static asset caching
    <FilesMatch "\.(ico|pdf|jpg|jpeg|png|gif|webp|svg|js|css|woff|woff2|ttf|eot)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>

    # HTML must revalidate
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "max-age=0, must-revalidate"
    </FilesMatch>

    # Security headers
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"

</IfModule>

# ==============================================================================
# END OF CONFIGURATION
# ==============================================================================
